---
import "../styles/posts.css";
const {
  title,
  date,
  category,
  author = [],
  tags = [],
  description,
} = Astro.props.frontmatter;
const { id } = Astro.props;
---

<a href=`/posts/${id}`>
  <div class="post-card">
    <h2 class="post-title">{title}</h2>
    <p class="post-desc">{description}</p>

    <div class="idk">
      <div class="post-meta">
        <div class="meta-left">
          {
            tags.length > 0 && (
              <div class="tags">
                {tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )
          }
        </div>
        {category && <span class="badge category">{category}</span>}
      </div>

      <div class="post-footer">
        <div class="authors">
          <i class="fa-regular fa-user"></i>
          <span>
            {
              author.map((a, i) => (
                <span>
                  {a}
                  {i < author.length - 1 ? ", " : ""}
                </span>
              ))
            }
          </span>
        </div>

        <div class="date">
          <i class="fa-regular fa-calendar"></i>
          <span>
            {
              new Date(date).toLocaleDateString(undefined, {
                year: "numeric",
                month: "short",
                day: "numeric",
              })
            }
          </span>
        </div>
      </div>
    </div>
  </div>
</a>
